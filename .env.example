# ---- Browser / APK (baked in at build time, safe to expose) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Absolute URL of the Vercel deployment. Needed by the APK to reach /api. Leave blank on the web.
VITE_API_BASE_URL=https://your-app.vercel.app

# ---- Server only (Vercel project env vars, never prefix with VITE_) ----
# The API reuses VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY; no service-role key is needed.

# ---- Email: the first one configured is used ----
# 1) Gmail / Google Workspace: send from your own mailbox (e.g. hello@utilitydeals.com.au).
#    Needs 2-step verification on that Google account and an App Password (myaccount.google.com/apppasswords).
GMAIL_USER=hello@utilitydeals.com.au
GMAIL_APP_PASSWORD=
# Optional: send as an alias set up in Gmail ("Send mail as"), otherwise GMAIL_USER is used
EMAIL_FROM_ADDRESS=
# 2) Make: a scenario that starts with "Custom webhook" and sends with the Gmail module
MAKE_WEBHOOK_URL=
# 3) Resend
RESEND_API_KEY=
EMAIL_FROM="Utility Deals <onboarding@resend.dev>"

EMAIL_FROM_NAME=Utility Deals
EMAIL_REPLY_TO=
# Where new-bill alerts for your team go (defaults to GMAIL_USER)
TEAM_NOTIFY_EMAIL=
# Used for the logo in emails
PUBLIC_SITE_URL=https://utility-deals-bill-upload.vercel.app

# SMS: "textbelt" (free key = 1 SMS/day), "twilio" (free trial credit) or "none"
SMS_PROVIDER=textbelt
TEXTBELT_KEY=textbelt
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
