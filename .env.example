# ---- Browser / APK (baked in at build time, safe to expose) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Absolute URL of the Vercel deployment. Needed by the APK to reach /api. Leave blank on the web.
VITE_API_BASE_URL=https://your-app.vercel.app

# ---- Server only (Vercel project env vars, never prefix with VITE_) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email via Resend (free: 3,000 emails/month)
RESEND_API_KEY=re_xxx
EMAIL_FROM="Utility Deals <onboarding@resend.dev>"
# Where new-bill alerts for your team go
TEAM_NOTIFY_EMAIL=team@utilitydeals.com.au

# SMS: "textbelt" (free key = 1 SMS/day), "twilio" (free trial credit) or "none"
SMS_PROVIDER=textbelt
TEXTBELT_KEY=textbelt
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
